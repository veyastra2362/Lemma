{
  "manifest_version": 3,
  "name": "Lemma 回填",
  "version": "0.1.0",
  "description": "把 Lemma 的译文写回网页原文位置。与本地 Lemma 桌面应用通过 Native Messaging 通信。",
  "key": "",
  "permissions": ["nativeMessaging", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "用 Lemma 翻译选中文本",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "翻译选中文本并在原位回填"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lemma-writeback@lunar.dev",
      "strict_min_version": "115.0"
    }
  }
}
